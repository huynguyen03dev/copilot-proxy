{
  "name": "vscode-copilot-api-server",
  "version": "1.0.0",
  "description": "Local API server that exposes GitHub Copilot as OpenAI-compatible endpoint",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "copilot-server": "bin/cli.js" },


  "type": "module",
  "scripts": {
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --sourcemap --out-dir dist --clean",
    "prepublishOnly": "npm run build",

    "type-check": "tsc -p tsconfig.types.json --noEmit",
    "test": "node --test",
    "test:streaming-py": "python scripts/tests/test.py",
    "test:performance": "python scripts/performance-test.py",
    "debug": "python debug-test.py",
    "auth": "node dist/index.js --auth",
    "clear-auth": "node dist/index.js --clear-auth"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.3",
    "@hono/zod-validator": "^0.2.2",
    "hono": "^4.6.3",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2"
  },
  "engines": { "node": ">=18" },
  "files": ["dist", "bin", "README.md", "LICENSE"],

  "keywords": [
    "github-copilot",
    "openai-api",
    "local-server",
    "vscode"
  ],
  "author": "",
  "license": "MIT"
}
